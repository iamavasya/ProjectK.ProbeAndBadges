{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projectk-catalog",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // /admin is the static admin page; everything under /v1 runs the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalog",
      // `wrangler d1 create catalog` prints the id; put it here before the first deploy.
      "database_id": "fb30b0d1-3246-4b1d-a3b4-89e7546236fd",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "projectk-catalog" }],
  "vars": {
    // Zero Trust → Settings → Custom pages shows the team domain; the Access application
    // guarding /admin, /v1/admin and /v1/submissions shows its AUD tag.
    "ACCESS_TEAM_DOMAIN": "https://billowing-lake-958a.cloudflareaccess.com",
    "ACCESS_AUD": "32f8259e640702a140a5617181a5ec8db20e0301e3571a20f2c2a584e40881b4",
    "OWNER_EMAILS": "snowyfl1cker@gmail.com"
  },
  // Cache API only works on a custom domain, not on *.workers.dev.
  // The old host stays: self-host installs already in the field read it.
  "routes": [
    { "pattern": "catalog.lileyka.app", "custom_domain": true },
    { "pattern": "catalog.rostyslav-mukha.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
