{
  "name": "projectk-catalog-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply catalog --local",
    "db:migrate:remote": "wrangler d1 migrations apply catalog --remote",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.1",
    "@cloudflare/workers-types": "5.20261013.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.150.0"
  }
}
